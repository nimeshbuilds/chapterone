{
  "name": "chapterone",
  "version": "0.1.0",
  "description": "ChapterOne — Your Personal Book Writer. Generate professional, bestseller-quality books with the Claude Code, Codex, or Gemini CLI on your own subscription, research-grounded with royalty-free images, read them in-app, export to Kindle (EPUB/PDF), and send to your Kindle.",
  "author": {
    "name": "Modulagent"
  },
  "license": "MIT",
  "homepage": "https://github.com/npandeya/bookwriter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/npandeya/bookwriter.git"
  },
  "bugs": {
    "url": "https://github.com/npandeya/bookwriter/issues"
  },
  "keywords": [
    "book-writer",
    "ai-book-generator",
    "ebook",
    "epub",
    "audiobook",
    "kindle",
    "electron",
    "desktop-app",
    "claude-code",
    "codex",
    "gemini",
    "elevenlabs",
    "text-to-speech",
    "writing",
    "publishing",
    "kids-books",
    "macos"
  ],
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "icon": "electron scripts/make-icon.js",
    "test": "node --test",
    "pack": "electron-builder --dir --config electron-builder.config.js",
    "dist": "electron-builder --config electron-builder.config.js",
    "dist:mac": "electron-builder --mac --universal --config electron-builder.config.js",
    "dist:mac:arm64": "electron-builder --mac --arm64 --config electron-builder.config.js",
    "dist:mac:x64": "electron-builder --mac --x64 --config electron-builder.config.js",
    "dist:win": "electron-builder --win --x64 --arm64 --config electron-builder.config.js",
    "dist:all": "npm run dist:mac && npm run dist:win"
  },
  "dependencies": {
    "archiver": "^6.0.1",
    "marked": "^4.3.0",
    "nodemailer": "^9.0.1"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.modulagent.chapterone",
    "productName": "ChapterOne",
    "copyright": "Copyright © 2026 Modulagent",
    "files": [
      "src/**/*",
      "assets/**/*",
      "!**/*.test.js",
      "!**/__tests__/**"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "ChapterOne records short voice samples so you can narrate your books in your own cloned voice."
      }
    },
    "dmg": {
      "title": "${productName} ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ChapterOne"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  }
}
