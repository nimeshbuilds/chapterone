{
  "name": "modulagent-book-writer",
  "version": "0.1.0",
  "description": "Modulagent's Book Writer — generate professional, bestseller-quality books with the Claude Code or Codex CLI on your own subscription, research-grounded with royalty-free images, read them in-app, export to Kindle (EPUB/PDF), and send to your Kindle.",
  "author": {
    "name": "Modulagent"
  },
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:all": "electron-builder -mw"
  },
  "dependencies": {
    "archiver": "^6.0.1",
    "marked": "^4.3.0",
    "nodemailer": "^6.9.13"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.modulagent.bookwriter",
    "productName": "Modulagent's Book Writer",
    "copyright": "Copyright © 2026 Modulagent",
    "files": [
      "src/**/*",
      "assets/**/*",
      "!**/*.test.js",
      "!**/__tests__/**"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "${productName} ${version}",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Modulagent's Book Writer"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Office"
    }
  }
}
