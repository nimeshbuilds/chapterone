{
  "name": "chapterone",
  "version": "0.3.0",
  "description": "ChapterOne — Your Personal Book Writer. Turn one idea into a finished book with Claude Code, Codex, Grok (your subscriptions) or Gemini (API key): planned, research-grounded, written, illustrated with AI art, narrated, and delivered to Kindle, EPUB, PDF, DOCX, or the web.",
  "author": {
    "name": "Modulagent"
  },
  "license": "MIT",
  "homepage": "https://nimeshbuilds.github.io/chapterone/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nimeshbuilds/chapterone.git"
  },
  "bugs": {
    "url": "https://github.com/nimeshbuilds/chapterone/issues"
  },
  "keywords": [
    "book-writer",
    "ai-book-generator",
    "ebook",
    "epub",
    "audiobook",
    "kindle",
    "electron",
    "desktop-app",
    "claude-code",
    "codex",
    "gemini",
    "elevenlabs",
    "text-to-speech",
    "writing",
    "publishing",
    "kids-books",
    "macos",
    "windows",
    "arm64"
  ],
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "icon": "electron scripts/make-icon.js",
    "test": "node --test",
    "pack": "electron-builder --dir --config electron-builder.config.js",
    "dist": "electron-builder --config electron-builder.config.js",
    "dist:mac": "electron-builder --mac --universal --config electron-builder.config.js",
    "dist:mac:arm64": "electron-builder --mac --arm64 --config electron-builder.config.js",
    "dist:mac:x64": "electron-builder --mac --x64 --config electron-builder.config.js",
    "dist:win": "electron-builder --win --x64 --arm64 --config electron-builder.config.js",
    "dist:all": "npm run dist:mac && npm run dist:win",
    "check": "node scripts/check.js",
    "test:smoke": "node scripts/run-smoke.cjs",
    "verify": "npm run check && npm test && npm audit --audit-level=high",
    "dist:win:x64": "electron-builder --win --x64 --config electron-builder.config.js",
    "dist:win:arm64": "electron-builder --win --arm64 --config electron-builder.config.js",
    "docs:build": "node scripts/docs-build.cjs",
    "docs:check": "node scripts/docs-build.cjs --check"
  },
  "dependencies": {
    "archiver": "7.0.1",
    "htmlparser2": "12.0.0",
    "marked": "^4.3.0",
    "nodemailer": "10.0.10",
    "postcss": "8.5.28",
    "sanitize-html": "2.17.7"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.modulagent.chapterone",
    "productName": "ChapterOne",
    "copyright": "Copyright © 2026 Modulagent",
    "files": [
      "src/**/*",
      "assets/**/*",
      "!**/*.test.js",
      "!**/__tests__/**",
      "LICENSE",
      "README.md",
      "SECURITY.md"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "ChapterOne records short voice samples so you can narrate your books in your own cloned voice.",
        "NSAppleEventsUsageDescription": "ChapterOne opens Terminal for AI provider login and creates Mail drafts when you choose to send a book."
      },
      "minimumSystemVersion": "13.0.0",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "${productName} ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ChapterOne",
      "deleteAppDataOnUninstall": false,
      "buildUniversalInstaller": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "nimeshbuilds",
        "repo": "chapterone",
        "releaseType": "draft"
      }
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
